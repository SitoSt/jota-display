# Variables de entorno del dispositivo (runtime)
# Copia este fichero como .env y rellena los valores reales.
# .env NUNCA se versiona — contiene secretos.

# Modo de despliegue: "termux" para Android/Termux
JOTA_MODE=termux

# Fully Kiosk Browser — Remote Admin password
# Configúrala en Fully Kiosk: Settings > Remote Administration > Password
JOTA_FULLY_PASSWORD=changeme

# URL de la API de Fully Kiosk (defecto: localhost, no cambiar salvo setup especial)
JOTA_FULLY_URL=http://localhost:2323

# Modo desarrollo: activa /dev/ha-state con fixtures (dev/fixtures/ha-state.json)
# NUNCA activar en producción
# JOTA_DEV=true
